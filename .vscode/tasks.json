      "type": "shell",
      "command": "cmake --preset Debug",
      "options": {
        "cwd": "${workspaceFolder}/test_0914",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/bin:/bin:${env:PATH}"
        }
      },
      "problemMatcher": []
    }
  ]
}
